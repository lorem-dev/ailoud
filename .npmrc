engine-strict=true
save-exact=true
strict-peer-dependencies=false

# typescript is pinned to 6.0.3 in the root package.json, not the newer
# 7.0.2, because typescript-eslint@8.67.0 declares the peer range
# ">=4.8.4 <6.1.0". Re-check that range with `pnpm peers check` before
# bumping either typescript or typescript-eslint.
