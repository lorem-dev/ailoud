* text=auto eol=lf
*.sh text eol=lf

*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text

# Video fixtures: `ailoud audio import` accepts video because a meeting
# recording usually is one, and the four containers it maps to a MIME type each
# get one. They are tiny (under 15 kB) but binary, so LFS keeps them out of the
# packfile like the audio.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

pnpm-lock.yaml linguist-generated=true
