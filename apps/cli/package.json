{
  "name": "ailoud",
  "version": "1.0.0-dev.1",
  "type": "module",
  "bin": {
    "ailoud": "./dist/bin/ailoud.js"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@ailoud/core": "workspace:*",
    "@ailoud/providers": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "string-width": "8.2.2",
    "wrap-ansi": "10.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && chmod +x dist/bin/ailoud.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "description": "Transcribe audio and video into a local library, then search and summarise it",
  "author": "Lorem Dev <contact@lorem.dev>",
  "license": "Apache-2.0",
  "homepage": "https://lorem-dev.github.io/ailoud/",
  "bugs": {
    "url": "https://github.com/lorem-dev/ailoud/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "transcription",
    "whisper",
    "speech-to-text",
    "summarisation",
    "mcp",
    "cli",
    "audio",
    "video",
    "meetings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorem-dev/ailoud.git",
    "directory": "apps/cli"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
