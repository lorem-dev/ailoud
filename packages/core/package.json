{
  "name": "@ailoud/core",
  "version": "1.0.0-dev.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "description": "AILoud domain model, ports and pure logic: the layer that does no I/O",
  "author": "Lorem Dev <contact@lorem.dev>",
  "license": "Apache-2.0",
  "homepage": "https://lorem-dev.github.io/ailoud/",
  "bugs": {
    "url": "https://github.com/lorem-dev/ailoud/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "ailoud",
    "transcription",
    "audio",
    "domain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorem-dev/ailoud.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
